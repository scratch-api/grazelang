stage {
    // You can declare backdrops either with the `backdrop` keyword or the `costume` keyword
    backdrop backdrop_1("empty.svg");

    let score = 0;
    let list scores = [10, 20, 30];
}

// The canonical name of this sprite is `Game` and the internal name is `game`
// An explicit canonical name is optional, the internal name is the fallback
sprite `Game` game {
    // Costumes can only be declared with the `costume` keyword
    costume costume_1("empty.svg");

    when_green_flag_clicked {
        // Declaring a variable as a normal statement causes the variable to be assigned to every time the declaration is reached
        let local lives = 3;
        score = 0;
        scores.push(42);
        scores[1] = 99;
        repeat 3 {
            say("tick");
            wait(0.5);
        }
        if lives > 0 {
            // You can use ${} to create formatted strings
            say("lives = ${lives}");
        }
    }

    // This is an isolated code block that will not have a hat block
    {
        scores.clear();
    }
}